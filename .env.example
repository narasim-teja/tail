# === NEAR testnet ===
NEAR_NETWORK=testnet
# Parent account that creates player sub-accounts and pays gas
NEAR_RELAY_ACCOUNT=your-account.testnet
NEAR_RELAY_PRIVATE_KEY=ed25519:PLACEHOLDER
# Deployed tail contract
TAIL_CONTRACT=tail.your-account.testnet

# === OutLayer (referee enclave) ===
OUTLAYER_API=https://testnet-api.outlayer.ai
OUTLAYER_PAYMENT_KEY=your-payment-key-here
OUTLAYER_OWNER=your-account.testnet
OUTLAYER_PROJECT=tail-referee
# Payment key scoped to the referee project (or owner/*); scripts prefer it over OUTLAYER_PAYMENT_KEY
REFEREE_PAYMENT_KEY=your-payment-key-here
REFEREE_PROJECT=tail-referee
# outlayer (default): the referee in OutLayer's enclave. local: the same referee code run on this
# machine as a test referee (not an enclave), for when OutLayer is unavailable. Local mode plays
# against LOCAL_TAIL_CONTRACT, a separate contract that pins the local referee's keys.
REFEREE_MODE=outlayer
LOCAL_TAIL_CONTRACT=tail-local.your-account.testnet
# Optional: the native referee binary and its key directory (defaults shown in apps/server/src/config.ts)
# LOCAL_REFEREE_BIN=crates/referee-wasi/target/release/tail-referee
# LOCAL_REFEREE_DIR=.keys/local-referee   (holds the local referee's private keys; keep it ignored)

# === NEAR AI Cloud (Handler voice) ===
NEARAI_API_BASE=https://cloud-api.near.ai/v1
NEARAI_API_KEY=your-key-here
NEARAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# === Apple ===
APPLE_TEAM_ID=PLACEHOLDER
IOS_BUNDLE_ID=PLACEHOLDER

# === Logging ===
LOG_LEVEL=info

# === Relay (apps/server) ===
RELAY_PORT=8787
# SQLite file; defaults to apps/server/data/relay.db
RELAY_DB=
# NEAR RPC; defaults to https://test.rpc.fastnear.com
NEAR_RPC_URL=
# Token players are registered on and matches are staked in
TAIL_TOKEN=usdc.fakes.testnet
# App Attest environment the phones attest in: development or production
APP_ATTEST_ENV=development
# Optional: wasm sha256 of the referee version to call instead of the active one
REFEREE_VERSION=
# Testing door: 1 lets ghost players enrol without App Attest. Only honoured on testnet.
ALLOW_GHOSTS=0
