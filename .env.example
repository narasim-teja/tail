# === NEAR testnet ===
NEAR_NETWORK=testnet
# Parent account that creates player sub-accounts and pays gas
NEAR_RELAY_ACCOUNT=your-account.testnet
NEAR_RELAY_PRIVATE_KEY=ed25519:PLACEHOLDER
# Deployed tail contract
TAIL_CONTRACT=tail.your-account.testnet
# Optional: the relay address built into the iPhone app (apps/mobile), e.g. http://192.168.1.20:8787.
# A player can type another under Settings > Advanced; empty, first launch asks for one
TAIL_RELAY_URL=

# === OutLayer (referee enclave) ===
OUTLAYER_API=https://testnet-api.outlayer.ai
OUTLAYER_PAYMENT_KEY=your-payment-key-here
OUTLAYER_OWNER=your-account.testnet
OUTLAYER_PROJECT=tail-referee
# Payment key scoped to the referee project (or owner/*); scripts prefer it over OUTLAYER_PAYMENT_KEY
REFEREE_PAYMENT_KEY=your-payment-key-here
REFEREE_PROJECT=tail-referee
# outlayer (default): the referee in OutLayer's enclave. local: the same referee code run on this
# machine as a test referee (not an enclave), for when OutLayer is unavailable. Both play on
# TAIL_CONTRACT; switching means pinning that referee's keys there (apps/server/scripts/pin-referee.ts).
REFEREE_MODE=outlayer
# Optional: the native referee binary and its key directory (defaults shown in apps/server/src/config.ts)
# LOCAL_REFEREE_BIN=crates/referee-wasi/target/release/tail-referee
# LOCAL_REFEREE_DIR=.keys/local-referee   (holds the local referee's private keys; keep it ignored)

# === NEAR AI Cloud (Handler voice) ===
NEARAI_API_BASE=https://cloud-api.near.ai/v1
NEARAI_API_KEY=your-key-here
NEARAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# === Apple ===
APPLE_TEAM_ID=PLACEHOLDER
IOS_BUNDLE_ID=PLACEHOLDER

# === Logging ===
LOG_LEVEL=info

# === Relay (apps/server) ===
RELAY_PORT=8787
# SQLite file; defaults to apps/server/data/relay.db
RELAY_DB=
# Hours after End a private (or failed) match's record of where and how it was played is kept; defaults to 24
RELAY_RETENTION_HOURS=
# Directory for the relay's mesh carry keys (box and receipt keys, made on first start);
# defaults to .keys/relay. Holds private keys: keep it ignored
RELAY_KEYS_DIR=
# Optional: the header a reverse proxy in front of the relay sets to the client's address
# (e.g. cf-connecting-ip, x-forwarded-for). Leave empty when clients connect directly: a header is
# trusted only when a proxy you run overwrites it.
RELAY_CLIENT_IP_HEADER=
# Optional: the web replay's address (apps/web), http(s), no trailing slash. GET /health hands it
# to the phones, which link each finished match to <this>/?match=<id>. Empty: no replay link
RELAY_REPLAY_URL=
# New phone enrolments per rolling day, in all and per client address; default 100 and 3
RELAY_ENROLS_PER_DAY=
RELAY_ENROLS_PER_IP_PER_DAY=
# NEAR RPC; defaults to https://test.rpc.fastnear.com
NEAR_RPC_URL=
# Token players are registered on and matches are staked in
TAIL_TOKEN=usdc.fakes.testnet
# App Attest environment the phones attest in: development or production
APP_ATTEST_ENV=development
# Optional: wasm sha256 of the referee version to call instead of the active one
REFEREE_VERSION=
# Testing door: 1 lets ghost players enrol without App Attest. Only honoured on testnet.
ALLOW_GHOSTS=0
# Referee side of the door (testnet only): 1 lets the referee register ghost players without an
# Apple attestation. Set it in the OutLayer project's secrets; the relay passes it to the local
# referee by itself, exactly when ALLOW_GHOSTS=1.
ALLOW_UNATTESTED=0

# The public site (apps/web): its canonical address; overrides for the GitHub and docs links
# (built-in defaults when empty); and the player whose dossier the front page shows (none when empty).
VITE_SITE_URL=https://playtail.app
VITE_REPO_URL=
VITE_DOCS_URL=
VITE_DOSSIER_ACCOUNT=
