{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": [
              "Eyebrow",
              "Caption",
              "Label",
              "Body",
              "Strong",
              "Title",
              "Display",
              "Poster",
              "Num",
              "Figure"
            ]
          }
        }
      }
    }
  }
}
